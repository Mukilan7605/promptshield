# ── Version control ──────────────────────────────────────────
.git
.gitignore
.github

# ── Python artifacts ─────────────────────────────────────────
__pycache__
*.py[cod]
*$py.class
.venv
venv
env
*.egg-info
.pytest_cache
.coverage
htmlcov
.mypy_cache
.ruff_cache

# ── Node / Frontend (the builder stage copies its own files) ──
# Don't send node_modules — builder runs npm ci from scratch
frontend/node_modules
frontend/dist
frontend/.vercel

# ── ML models (large files, not needed for prod w/ ML disabled)
models/
Datasets/
notebooks/
reports/

# ── Data & logs (created at runtime) ─────────────────────────
data/
logs/
*.db
*.sqlite
*.log

# ── Dev/test files ────────────────────────────────────────────
scripts/
tests/
Datasets/
docker-compose.yml
*.md
.env
.env.*
