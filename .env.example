# ── Application ──────────────────────────────────────────────
APP_NAME=PromptShield
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_VERSION=0.1.0

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1                # Increase for production
API_RELOAD=true              # Set false in production
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ─────────────────────────────────────────────────
# SQLite (default for development)
DATABASE_URL=sqlite:///./data/promptshield.db

# PostgreSQL (uncomment and fill in for staging/production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/promptshield_db

# ── ML / Model ───────────────────────────────────────────────
# Base HuggingFace model to use for fine-tuning
BASE_MODEL_NAME=distilbert-base-uncased
MODEL_CACHE_DIR=./models/cache
FINE_TUNED_MODEL_PATH=./models/fine_tuned/promptshield_v1
# Max sequence length for tokenizer
MAX_SEQ_LENGTH=512
# Detection confidence threshold (0.0 – 1.0)
DETECTION_THRESHOLD=0.85

# ── Detection Layers ─────────────────────────────────────────
ENABLE_RULE_BASED=true
ENABLE_ML_BASED=true
ENABLE_LLM_GUARD=false       # Future: external LLM-as-a-judge

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # json | text
LOG_FILE=./logs/promptshield.log

# ── Feature Flags ────────────────────────────────────────────
ENABLE_ANALYTICS_DASHBOARD=true
ENABLE_AUDIT_LOG=true
